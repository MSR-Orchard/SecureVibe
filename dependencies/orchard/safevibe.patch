+def _build_hinted_teacher_input_ids(sample: Sample, cfg, student_tokenizer, teacher_tokenizer) -> list[int]:
+    """Insert an instance-specific teacher hint at the prompt/response boundary.
+
+    The response remains a contiguous suffix, preserving the existing OPD
+    log-probability alignment. Hints are intentionally unsupported across
+    different vocabularies until full text reconstruction/alignment is added.
+    """
+    metadata_key = getattr(cfg, "hint_metadata_key", None)
+    if not metadata_key:
+        return list(sample.tokens)
+
+    hint = (sample.metadata or {}).get(metadata_key)
+    if hint is None or hint == "":
+        return list(sample.tokens)
+    if not isinstance(hint, str):
+        raise ValueError(
+            f"OPD teacher hint metadata {metadata_key!r} must be a string, got {type(hint).__name__}."
+        )
+    if not _is_same_vocab(student_tokenizer, teacher_tokenizer):
+        raise ValueError(
+            "OPD teacher-only hints require identical student and teacher vocabularies; "
+            "cross-vocabulary hinted requests are not supported."
+        )
+
+    rendered_hint = cfg.hint_template.format(hint=hint)
+    hint_ids = student_tokenizer.encode(rendered_hint, add_special_tokens=False)
+    prompt_length = len(sample.tokens) - sample.response_length
+    if prompt_length < 0:
+        raise ValueError(
+            f"Sample response_length={sample.response_length} exceeds token count={len(sample.tokens)}."
+        )
+    logger.info(
+        "[opd] inserting teacher-only hint for instance_id=%s: hint_tokens=%d",
+        (sample.metadata or {}).get("instance_id", "unknown"),
+        len(hint_ids),
     )
+    return list(sample.tokens[:prompt_length]) + hint_ids + list(sample.tokens[prompt_length:])
+
+
+def _get_hint_tokenizers(args, cfg):
+    """Lazily load tokenizers needed to encode and validate teacher-only hints."""
+    global _student_tokenizer, _teacher_tokenizer, _student_tokenizer_path, _teacher_tokenizer_path
+
+    from transformers import AutoTokenizer
+
+    student_path = getattr(args, "hf_checkpoint", None)
+    if not student_path:
+        raise ValueError("--hf-checkpoint is required when OPD teacher-only hints are enabled.")
+    teacher_path = cfg.tokenizer_path or student_path
+    if _student_tokenizer is None or _student_tokenizer_path != student_path:
+        _student_tokenizer = AutoTokenizer.from_pretrained(student_path, trust_remote_code=True)
+        _student_tokenizer_path = student_path
+    if _teacher_tokenizer is None or _teacher_tokenizer_path != teacher_path:
+        _teacher_tokenizer = AutoTokenizer.from_pretrained(teacher_path, trust_remote_code=True)
+        _teacher_tokenizer_path = teacher_path
+    return _student_tokenizer, _teacher_tokenizer
 
 
